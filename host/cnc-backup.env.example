# /etc/cnc-backup.env  (created by host/setup-backup.sh; mode 0600)
# Where backups go: any restic repository, e.g.
#   /mnt/backup/cnc  |  sftp:backup@fileserver:/backups/cnc  |  rest:https://backup.example.com/cnc
RESTIC_REPOSITORY=
# Random password protecting the repository. Keep a copy OFF the Pi.
RESTIC_PASSWORD_FILE=/etc/cnc-backup.pass
