# Copy to .env and edit. Everything else (machines, users, IPs, firewall) is
# managed in the admin web page and stored in config/site.json.

# Name IT registers for the Pi's office address (used for the HTTPS certificate).
OFFICE_HOSTNAME=cnc-files.example.com

# Owner of every file under /srv/cnc (created by host/install.sh).
CNC_UID=2000
CNC_GID=2000

# Set to "yes" only if a control insists on connecting by NetBIOS name instead of IP.
ENABLE_NMBD=no

# Platform for the FOCAS bridge. Leave unset: host/install.sh sets it for this CPU
# (linux/arm/v7 on a Pi, linux/amd64 on an x86-64 PC).
# FOCAS_PLATFORM=
