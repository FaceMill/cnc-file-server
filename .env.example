# Copy to .env and edit. Everything else (machines, users, IPs, firewall) is
# managed in the admin web page and stored in config/site.json.

# Name IT registers for the Pi's office address (used for the HTTPS certificate).
OFFICE_HOSTNAME=cnc-files.example.com

# Owner of every file under /srv/cnc (created by host/install.sh).
CNC_UID=2000
CNC_GID=2000

# Set to "yes" only if a control insists on connecting by NetBIOS name instead of IP.
ENABLE_NMBD=no

# Network ports. Office: eth0 (the Pi's own port), or wlan0 on a Wi-Fi test bench.
# CNC: one port (eth1, a USB adapter, to the CNC switch), or several separated by spaces
# ("eth1 eth2"): they are bridged as br-cnc so the Pi acts as the switch. Check the names
# with: ip -br link
OFFICE_IF=eth0
CNC_IF=eth1

# Office side: "client" (the office network, default) or "hotspot": the Pi's own Wi-Fi
# access point, for setup and bench tests without an office network (set OFFICE_IF=wlan0).
# Laptops that join reach https://10.42.0.1:8443 and \\10.42.0.1\CNC. The installer
# switches the hotspot on as its last step and creates HOTSPOT_PASSWORD if it's empty.
OFFICE_MODE=client
# HOTSPOT_SSID=cnc-setup
# HOTSPOT_PASSWORD=

# Platform for the FOCAS bridge. Leave unset: host/install.sh sets it for this CPU
# (linux/arm/v7 on a Pi, linux/amd64 on an x86-64 PC).
# FOCAS_PLATFORM=
