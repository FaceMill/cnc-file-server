# Generated by cnc-admin from config/site.json. Do not edit; changes are overwritten.
# CNC side: SMB1 for old controls (newer ones may negotiate SMB2/3), bound to the
# CNC interface. Each machine sees only its own share.
[global]
    server role = standalone server
    workgroup = {{ site.workgroup }}
    netbios name = CNCSRV
    server string = CNC file server

    interfaces = {{ cnc.interface }}
    bind interfaces only = yes
    hosts allow = {{ smb_machines | map(attribute='ip') | join(' ') or '127.0.0.1' }}
    smb ports = 445 139

    server min protocol = NT1
    server max protocol = SMB3
    # Haas Classic and Windows XP authenticate with NTLMv1.
    ntlm auth = ntlmv1-permitted
    restrict anonymous = 2
    map to guest = never
    # Old clients can't create symlinks, and none are followed.
    smb1 unix extensions = no
    follow symlinks = no

    # The same files are served over SMB3 by samba-office and over FTP: no client-side caching.
    oplocks = no
    level2 oplocks = no

    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes
    log level = 1

    force user = cncfiles
    force group = cncfiles
    create mask = 0664
    directory mask = 0775
    read only = no
    hide files = /.recycle/
    vfs objects = recycle
    recycle:repository = .recycle
    recycle:keeptree = yes
    recycle:versions = yes
{% for m in smb_machines %}

[{{ m.name }}]
    comment = {{ m.label }}
    path = /srv/cnc/{{ m.name }}
    valid users = {{ m.name }}
    hosts allow = {{ m.ip }}
{% endfor %}
