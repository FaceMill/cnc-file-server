# Generated by cnc-admin from config/site.json. Do not edit; changes are overwritten.
# Loaded at boot via the include in /etc/nftables.conf.
flush ruleset

table inet filter {
	chain input {
		type filter hook input priority 0; policy drop;

		iif lo accept
		ct state established,related accept
		ct state invalid drop
		# Only accept traffic addressed to the interface it arrived on: the CNC network
		# can't reach office-side services via the Pi's office IP, and vice versa.
		fib daddr . iif type != { local, broadcast, multicast } drop
		meta l4proto { icmp, ipv6-icmp } limit rate 10/second accept

		# Office: SSH, web (443 redirects to the admin page on 8443, Cockpit 9090), SMB3
		iifname "{{ office.interface }}" ip saddr { {{ office.allowed_subnets | join(', ') }} } tcp dport { 22, 80, 443, 445, 8443, 9090 } accept
{% if office.get('hotspot') %}

		# Setup hotspot: the Pi is the access point. DHCP (requests come from 0.0.0.0) and DNS
		# for the laptops that join it; nothing is routed onwards (forward chain below).
		iifname "{{ office.interface }}" udp sport 68 udp dport 67 accept
		iifname "{{ office.interface }}" ip saddr {{ hotspot_subnet }} meta l4proto { tcp, udp } th dport 53 accept
{% endif %}
{% if smb_machines %}

		# SMB machines: SMB1/2/3 and NetBIOS
		iifname "{{ cnc.interface }}" ip saddr { {{ smb_machines | map(attribute='ip') | join(', ') }} } tcp dport { 139, 445 } accept
		iifname "{{ cnc.interface }}" ip saddr { {{ smb_machines | map(attribute='ip') | join(', ') }} } udp dport { 137, 138 } accept
{% endif %}
{% if ftp_machines %}

		# FTP machines: control port and passive data ports (active mode uses outbound port 20)
		iifname "{{ cnc.interface }}" ip saddr { {{ ftp_machines | map(attribute='ip') | join(', ') }} } tcp dport { 21, {{ pasv_min }}-{{ pasv_max }} } accept
{% endif %}
{% if serial_tcp_machines %}

		# Serial device servers ({{ serial_tcp_machines | map(attribute='ip') | join(', ') }}) need no inbound rule: the Pi connects out to them.
{% endif %}
	}

	# Never route between the office and CNC networks.
	chain forward {
		type filter hook forward priority 0; policy drop;
	}

	chain output {
		type filter hook output priority 0; policy accept;
	}
}
