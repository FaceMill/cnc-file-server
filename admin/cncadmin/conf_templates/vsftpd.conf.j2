# Generated by cnc-admin from config/site.json. Do not edit; changes are overwritten.
# CNC-side FTP server for FTP-capable controls (FANUC Data Server / embedded Ethernet, ...).
# Plain FTP is only acceptable because this listens on the isolated CNC network.
listen=YES
listen_ipv6=NO
listen_address={{ cnc_ip }}
background=NO
seccomp_sandbox=NO

anonymous_enable=NO
local_enable=YES
write_enable=YES
local_umask=002
file_open_mode=0664

# Only machine accounts; each is locked into its own folder.
userlist_enable=YES
userlist_deny=NO
userlist_file=/etc/vsftpd.user_list
chroot_local_user=YES
allow_writeable_chroot=YES
hide_ids=YES

# Old controls differ: support both active (PORT) and passive (PASV) mode.
connect_from_port_20=YES
pasv_enable=YES
pasv_address={{ cnc_ip }}
pasv_min_port={{ pasv_min }}
pasv_max_port={{ pasv_max }}

# Transfer files byte-for-byte (no ASCII line-ending conversion).
ascii_upload_enable=NO
ascii_download_enable=NO

idle_session_timeout=900
data_connection_timeout=300
setproctitle_enable=YES
xferlog_enable=YES
xferlog_std_format=NO
vsftpd_log_file=/var/log/vsftpd.log
