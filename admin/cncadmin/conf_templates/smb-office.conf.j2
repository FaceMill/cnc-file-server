# Generated by cnc-admin from config/site.json. Do not edit; changes are overwritten.
# Office side: SMB3 only, encrypted, bound to the office interface.
[global]
    server role = standalone server
    workgroup = {{ site.workgroup }}
    netbios name = CNC-FILES
    server string = CNC file server

    interfaces = {{ office.interface }}
    bind interfaces only = yes
    hosts allow = {{ office.allowed_subnets | join(' ') }}
    smb ports = 445
    disable netbios = yes

    server min protocol = SMB3
    server smb encrypt = required
    server signing = mandatory
    ntlm auth = ntlmv2-only
    restrict anonymous = 2
    map to guest = never
    follow symlinks = no

    # The same files are served to the machines by samba-cnc, ftp-cnc and DNC: no client-side caching.
    oplocks = no
    level2 oplocks = no

    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes
    log level = 1

[CNC]
    path = /srv/cnc
    comment = CNC programs (one folder per machine)
{% if office_users %}
    valid users = {{ office_users | map(attribute='name') | join(' ') }}
{% else %}
    available = no
{% endif %}
    read only = no
    force user = cncfiles
    force group = cncfiles
    create mask = 0664
    directory mask = 0775
    hide files = /.recycle/.removed/
    vfs objects = recycle
    recycle:repository = .recycle
    recycle:keeptree = yes
    recycle:versions = yes
